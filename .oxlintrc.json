{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "src/specklewidgets/static/**",
    "sandbox/**",
    "packages/*/dist/**",
    "site/dist/**",
    "site/public/**"
  ],
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": "error"
  },
  "env": {
    "builtin": true
  }
}
