{
  "npm": false,
  "git": {
    "commitMessage": "Release v${version}",
    "tagName": "v${version}",
    "requireBranch": "main",
    "requireCleanWorkingDir": true
  },
  "github": {
    "release": false
  },
  "hooks": {
    "before:init": ["pnpm run typecheck", "pnpm run test", "uv run pytest"],
    "after:bump": "uv lock"
  },
  "plugins": {
    "@release-it/bumper": {
      "in": { "file": "pyproject.toml", "path": "project.version" },
      "out": [
        { "file": "pyproject.toml", "path": "project.version" },
        { "file": "packages/geospeckle-viewer/package.json", "path": "version" }
      ]
    }
  }
}
